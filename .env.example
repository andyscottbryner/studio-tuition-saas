# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Stripe — Developers -> API keys
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                    # from the webhook endpoint you create (see README)
NEXT_PUBLIC_STRIPE_PRICE_ID=price_...              # the recurring Price ID for your subscription plan

# Your deployed site URL (no trailing slash). Used for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=https://yourapp.vercel.app
